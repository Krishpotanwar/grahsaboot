# Accounts are dormant until the owner activates them (docs/ops/accounts.md). Two files, never one:
#
# 1. Browser variables (VITE_ACCOUNTS, VITE_SUPABASE_URL, VITE_SUPABASE_PUBLISHABLE_KEY) go ONLY in
#    .env.development.local. The dev server (npm run dev) reads that file; production builds do not.
#    Never put them in .env.local: Vite loads .env.local in every build mode, so they would be baked into the
#    next npm run build / npm run deploy and ship the dev project, with accounts ON, to production.
# 2. Tooling variables (everything else) go in .env.local. They are never shipped to the browser.
#
# Both files are git-ignored. npm run env:check validates the pair.

# --- .env.development.local (browser; publishable values only) ---
VITE_ACCOUNTS=1
VITE_SUPABASE_URL=https://<dev-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable or anon key>

# --- .env.local (tooling only; never shipped to the browser) ---
SUPABASE_ACCESS_TOKEN=<personal access token from supabase.com/dashboard/account/tokens>
SUPABASE_DEV_REF=<dev project ref>
SUPABASE_DEV_DB_PASSWORD=<dev database password>
SUPABASE_PROD_REF=<prod project ref>
DEV_TEST_EMAIL=gs-smoke@example.com
DEV_TEST_PASSWORD=<long random password for the dev-only smoke user>
