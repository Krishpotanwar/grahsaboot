    "@phosphor-icons/react": "2.1.10",
    "@supabase/supabase-js": "2.117.2",
    "geotiff": "3.0.5",
    "maplibre-gl": "6.12.0",
    "motion": "14.0.0",
    "proj4": "2.22.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "satellite.js": "7.1.0",
    "terra-draw": "1.36.0",
    "terra-draw-maplibre-gl-adapter": "1.4.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
