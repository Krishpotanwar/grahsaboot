    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "deno": "2.9.6",
    "prettier": "3.9.9",
    "supabase": "2.119.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "wrangler": "4.147.0"
